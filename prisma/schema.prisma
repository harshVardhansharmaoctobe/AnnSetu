// FoodBridge – Prisma Schema
// Zero-Waste Food Rescue Coordination Platform
//
// Lifecycle (see docs/ARCHITECTURE.md):
//   FoodDonation.status tracks how much food is still unclaimed.
//   FoodRequest.status tracks one NGO's delivery from request to receipt:
//     PENDING → ACCEPTED → VOLUNTEER_ASSIGNED → PICKED_UP → DELIVERED → COMPLETED
//   Every transition is applied with a conditional update on the expected
//   current status, so invalid or concurrent transitions are rejected.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ──────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────

enum UserRole {
  DONOR
  NGO
  VOLUNTEER
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum DonationStatus {
  AVAILABLE // nothing reserved yet
  PARTIALLY_RESERVED // some quantity approved for NGOs, some still open
  FULLY_RESERVED // all quantity approved for NGOs
  COMPLETED // every approved request has been delivered
  EXPIRED // pickup deadline passed before it was fully claimed
  CANCELLED // withdrawn by the donor
}

enum RequestStatus {
  PENDING // NGO asked, donor has not decided
  ACCEPTED // donor approved; quantity reserved; awaiting volunteer
  REJECTED // donor declined
  CANCELLED // withdrawn by NGO, or donation cancelled
  VOLUNTEER_ASSIGNED // a volunteer holds an active assignment
  PICKED_UP // volunteer collected the food
  IN_TRANSIT // volunteer is on the way to the NGO
  DELIVERED // volunteer delivered with proof
  COMPLETED // NGO confirmed receipt (impact recorded)
  DISPUTED // NGO reported a problem on receipt
}

// One open assignment exists per approved request. Terminal rows (REJECTED, CANCELLED, COMPLETED) are
// kept as history; when a volunteer rejects or is removed, a fresh PENDING row is opened in the same transaction.
enum AssignmentStatus {
  PENDING // created at donor approval; open to eligible volunteers, no volunteer yet
  ASSIGNED // an admin offered it to a specific volunteer; awaiting their answer
  ACCEPTED // volunteer committed
  REJECTED // volunteer declined (history; a new PENDING assignment replaces it)
  PICKUP_IN_PROGRESS // volunteer arrived at the pickup point
  PICKED_UP // food collected
  IN_TRANSIT // on the way to the NGO
  DELIVERED // handed over with delivery proof
  COMPLETED // the NGO confirmed receipt
  CANCELLED // removed by admin/NGO, request cancelled, or delivery failed
}

enum UploadPurpose {
  DONATION_PHOTO
  PICKUP_PROOF
  DELIVERY_PROOF
  AVATAR
}

enum ProofType {
  PICKUP
  DELIVERY
}

enum FoodCategory {
  COOKED_MEALS
  RAW_VEGETABLES
  RAW_FRUITS
  BAKERY
  DAIRY
  BEVERAGES
  PACKAGED
  MIXED
  OTHER
}

enum FoodType {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
}

enum QuantityUnit {
  MEALS
  KG
}

enum NotificationType {
  REGISTRATION_SUBMITTED
  NEW_REQUEST
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  VOLUNTEER_ASSIGNED
  VOLUNTEER_ACCEPTED
  VOLUNTEER_DECLINED
  PICKUP_COMPLETED
  DELIVERY_COMPLETED
  RECEIPT_CONFIRMED
  DISPUTE_RAISED
  DISPUTE_RESOLVED
  DONATION_CANCELLED
  ASSIGNMENT_AVAILABLE
  ASSIGNMENT_CANCELLED
  DELIVERY_IN_TRANSIT
  DELIVERY_FAILED
  FEEDBACK_RECEIVED
  PASSWORD_RESET_REQUESTED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
  GENERAL
}

// ──────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  password          String
  name              String
  phone             String?
  role              UserRole
  accountStatus     AccountStatus @default(PENDING)
  isDemo            Boolean       @default(false) // created by prisma/seed.ts; lets dashboards separate demo data
  avatarUrl         String?
  passwordChangedAt DateTime? // sessions issued before this are revoked
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donorProfile     DonorProfile?
  ngoProfile       NGOProfile?
  volunteerProfile VolunteerProfile?

  notifications Notification[]
  auditLogs     AuditLog[]
  proofs        DeliveryProof[]
  uploads       Upload[]
  resetTokens   PasswordResetToken[]

  @@index([role])
  @@index([accountStatus])
  @@index([createdAt])
}

model DonorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  organisationName String
  organisationType String // restaurant, hotel, hostel, catering, event_organiser, college_mess, other
  address          String
  latitude         Float
  longitude        Float
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations FoodDonation[]
}

model NGOProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  organisationName   String
  registrationNumber String?
  address            String
  latitude           Float
  longitude          Float
  description        String?
  receivingCapacity  Int      @default(100) // max meals they can handle per pickup
  foodPreferences    String? // comma-separated FoodCategory values
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests FoodRequest[]
}

model VolunteerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  address      String? // service area
  latitude     Float?
  longitude    Float?
  vehicleType  String? // bike, car, bicycle, walking
  availability String? // free text, e.g. "Weekday evenings"
  isAvailable  Boolean  @default(true)
  maxDistance  Float    @default(15) // km
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments VolunteerAssignment[]
}

model FoodDonation {
  id                   String         @id @default(cuid())
  donorProfileId       String
  foodName             String
  description          String?
  foodCategory         FoodCategory
  foodType             FoodType
  quantity             Float
  remainingQuantity    Float // unreserved quantity; never negative (guarded by conditional updates)
  unit                 QuantityUnit
  preparationTime      DateTime
  storageConditions    String
  handlingInstructions String?
  contactPhone         String?
  safePickupDeadline   DateTime
  foodSafetyDeclared   Boolean        @default(false)
  photoUrl             String?
  pickupAddress        String
  latitude             Float
  longitude            Float
  status               DonationStatus @default(AVAILABLE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  donorProfile DonorProfile  @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)
  requests     FoodRequest[]

  @@index([status, safePickupDeadline])
  @@index([donorProfileId, createdAt])
  @@index([latitude, longitude])
  @@index([foodCategory])
}

model FoodRequest {
  id                String        @id @default(cuid())
  donationId        String
  ngoProfileId      String
  requestedQuantity Float
  deliveredQuantity Float?
  beneficiaryCount  Int?
  status            RequestStatus @default(PENDING)
  notes             String?
  rejectionReason   String?
  disputeReason     String?
  disputeResolution String? // admin's note when a reported problem is resolved
  disputeResolvedAt DateTime?
  feedbackRating    Int? // 1–5, given by the NGO when confirming receipt
  feedbackComment   String?
  approvedAt        DateTime?
  pickedUpAt        DateTime?
  inTransitAt       DateTime?
  deliveredAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donation    FoodDonation          @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngoProfile  NGOProfile            @relation(fields: [ngoProfileId], references: [id], onDelete: Cascade)
  assignments VolunteerAssignment[]
  proofs      DeliveryProof[]
  impact      ImpactRecord?

  // One request per NGO per donation; a cancelled request is reactivated instead of duplicated.
  @@unique([donationId, ngoProfileId])
  @@index([status])
  @@index([ngoProfileId, createdAt])
}

model VolunteerAssignment {
  id                 String           @id @default(cuid())
  requestId          String
  volunteerProfileId String? // null while PENDING (open to eligible volunteers)
  status             AssignmentStatus @default(PENDING)
  assignedById       String? // admin userId, null when self-claimed
  acceptedAt         DateTime?
  arrivedAt          DateTime?
  pickupTime         DateTime?
  inTransitAt        DateTime?
  deliveryTime       DateTime?
  completedAt        DateTime?
  rejectionReason    String?
  pickupProofUrl     String?
  deliveryProofUrl   String?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  request          FoodRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  volunteerProfile VolunteerProfile? @relation(fields: [volunteerProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requestId])
  @@index([volunteerProfileId, status])
}

model DeliveryProof {
  id            String    @id @default(cuid())
  requestId     String
  type          ProofType
  photoUrl      String?
  quantity      Float?
  notes         String?
  submittedById String
  createdAt     DateTime  @default(now())

  request     FoodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy User        @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model ImpactRecord {
  id                 String   @id @default(cuid())
  requestId          String   @unique
  donorProfileId     String
  ngoProfileId       String
  volunteerProfileId String?
  mealsRescued       Float
  weightKg           Float?
  co2SavedKg         Float? // estimate, see IMPACT_ESTIMATES in src/lib/matching.ts
  waterSavedLiters   Float? // estimate, see IMPACT_ESTIMATES in src/lib/matching.ts
  createdAt          DateTime @default(now())

  request FoodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([donorProfileId])
  @@index([ngoProfileId])
  @@index([volunteerProfileId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique // SHA-256 of the token; the token itself is never stored
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String? // admin who issued it, null when self-requested
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Upload {
  id           String        @id @default(cuid())
  fileName     String        @unique // server-generated UUID name
  url          String        @unique
  contentType  String
  size         Int
  purpose      UploadPurpose
  uploadedById String
  createdAt    DateTime      @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById, createdAt])
}
