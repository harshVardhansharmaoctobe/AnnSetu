# --- Server ---
PORT=4000
# Local: `npm run db` starts a mongod on 27017. Or use a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/trustchain
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Public URL of this API (used to build links for local-dev storage files)
PUBLIC_API_URL=http://localhost:4000

# --- Blockchain (read-only; the backend never holds a private key) ---
# Local Hardhat node: http://127.0.0.1:8545 / 31337. Sepolia: your RPC URL / 11155111.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Optional: if empty, read from backend/contract/deployment.json written by the deploy script.
CONTRACT_ADDRESS=
CONTRACT_DEPLOY_BLOCK=
INDEXER_ENABLED=true
INDEXER_POLL_MS=4000
INDEXER_BLOCK_CHUNK=2000
INDEXER_CONFIRMATIONS=0

# --- IPFS ---
# pinata | kubo | local   (local = development fallback, NOT IPFS; clearly labelled in the UI)
IPFS_PROVIDER=local
# pinata: https://api.pinata.cloud   kubo: http://127.0.0.1:5001
IPFS_API_URL=
# Pinata: either a JWT (preferred) ...
IPFS_JWT=
# ... or an API key + secret
IPFS_API_KEY=
IPFS_API_SECRET=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
LOCAL_STORAGE_DIR=.data/local-storage

# --- Uploads ---
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=6
