# ─── Database (local Docker: docker compose up -d) ───
# POSTGRES_PASSWORD is used by docker-compose.yml; DATABASE_URL must use the same password.
POSTGRES_PASSWORD="change-me-local-db-password"
DATABASE_URL="postgresql://postgres:change-me-local-db-password@localhost:5432/foodbridge?schema=public"

# ─── NextAuth ───
NEXTAUTH_URL="http://localhost:3000"
# Generate your own with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# ─── Google Maps (optional – Leaflet/OpenStreetMap used as fallback) ───
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Upload ───
MAX_FILE_SIZE_MB=10
UPLOAD_DIR="public/uploads"
