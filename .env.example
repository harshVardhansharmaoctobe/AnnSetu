# ─── Database (local Docker: docker compose up -d) ───
# POSTGRES_PASSWORD is used by docker-compose.yml; DATABASE_URL must use the same password.
POSTGRES_PASSWORD="change-me-local-db-password"
DATABASE_URL="postgresql://postgres:change-me-local-db-password@localhost:5432/foodbridge?schema=public"

# ─── NextAuth ───
NEXTAUTH_URL="http://localhost:3000"
# Generate your own with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# ─── Public site ───
# Optional support address shown on the landing page help section
SUPPORT_EMAIL=""

# ─── Upload ───
MAX_FILE_SIZE_MB=5
UPLOAD_DIR="uploads"

# ─── Rate limits (optional, defaults shown) ───
# LOGIN_MAX_FAILURES=5        # wrong passwords per email per 15 min
# REGISTER_RATE_LIMIT=10      # registrations per IP per hour
# UPLOAD_RATE_LIMIT=60        # uploads per user per hour

# ─── Local demo seed (npm run db:seed) – never use these in production ───
# Choose your own passwords; the seed refuses to run without them.
SEED_ADMIN_EMAIL="admin@foodbridge.local"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

# Address lookup (search + reverse geocoding) used by the location picker. Calls go through the
# FoodBridge server, throttled to 1 request/second and cached. Default: OpenStreetMap Nominatim.
# Set GEOCODER_URL=off to disable lookups (users then type the address and click the map).
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_COUNTRY=in
# Location diagnostics (server console: search results, saved coordinates). Development only – never in production.
# In the browser, run localStorage.fbLocationDebug = '1' and reload to log selection/sending/map stages.
# LOCATION_DEBUG=true
