# Backend API base URL
VITE_API_URL=http://localhost:4000/api
# Optional: TrustChain contract address. If empty, src/contracts/deployment.json (written by the deploy script) is used.
VITE_CONTRACT_ADDRESS=
# 31337 = local Hardhat node, 11155111 = Sepolia
VITE_CHAIN_ID=31337
# Block explorer base URL (no trailing slash). Leave empty for the local Hardhat node.
VITE_EXPLORER_URL=
# Public RPC used only when asking MetaMask to add the network (local default shown)
VITE_RPC_URL=http://127.0.0.1:8545
